#!/bin/bash

# Update the Widgets plugin, then restart the shell so the update is one you
# can see -- and say where the plugins its cards talk to have got to.
#
# `omarchy plugin update <id>` already does the careful part: it fetches,
# shows you the diff, fast-forwards only, validates the result and rolls back
# if validation fails. This wraps it for the two things it leaves out.
#
#   - It updates one plugin, and the Omate card is only as current as the
#     Omate plugin underneath it -- a card and a service that disagree about
#     an API is the failure this repo has already had once. So this script
#     ends by saying where the companion is and printing the line that
#     updates it -- but does not run that line: pulling somebody else's code
#     is a decision to make with their repository open, not a side effect of
#     updating this one.
#   - It rescans, which is not the same as reloading. `keepLoaded` panels are
#     mounted once and outlive the file they came from, so an update lands on
#     disk and changes nothing on screen until the shell restarts. Restarting
#     is skipped when nothing actually moved -- a restart for no reason costs
#     you every panel you had open.
#
# Usage: update [--yes] [--this-only] [--help]
#
#   --yes         take every prompt as answered, and skip the diffs
#   --this-only   accepted and ignored; companions are never updated for you

set -uo pipefail

ID="anishfn.widgets"
PLUGINS_DIR="$HOME/.config/omarchy/plugins"

# Named so the run can end by saying where each one is. Nothing here is ever
# passed to `omarchy plugin update` -- see the note at the top of this file.
COMPANIONS=(palccod.omate)

ASSUME_YES=0

say()  { printf '%s\n' "$*"; }
step() { printf '\n\033[1m%s\033[0m\n' "$*"; }
warn() { printf '  ! %s\n' "$*" >&2; }
fail() { printf 'update: %s\n' "$*" >&2; exit 1; }

while (( $# > 0 )); do
  case "$1" in
    --yes|-y)     ASSUME_YES=1; shift ;;
    # Kept so an existing habit or script does not start failing; the
    # behaviour it used to switch off is simply gone.
    --this-only)  shift ;;
    -h|--help)    sed -n '3,26p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)            fail "unknown option: $1 (try --help)" ;;
  esac
done

command -v omarchy >/dev/null 2>&1 || fail "omarchy not found."
[[ -d "$PLUGINS_DIR/$ID" ]] ||
  fail "$ID is not installed. Install it with: omarchy plugin add https://github.com/anishfn/omarchy-widgets.git"

head_of()    { git -C "$PLUGINS_DIR/$1" rev-parse --short HEAD 2>/dev/null; }
version_of() { jq -r '.version // "?"' "$PLUGINS_DIR/$1/manifest.json" 2>/dev/null || echo "?"; }

# What moved, rather than what was attempted: `omarchy plugin update` reports
# success for a plugin that was already current, and a restart is only earned
# by a commit that actually changed.
MOVED=()
# Everything looked at, moved or not, so the run ends by telling you what you
# are actually on rather than only what changed.
SEEN=()

update_one() {
  local id=$1 before after vbefore vafter shown
  [[ -d "$PLUGINS_DIR/$id" ]] || { say "  $id is not installed — skipped"; return 0; }
  [[ -d "$PLUGINS_DIR/$id/.git" ]] && before=$(head_of "$id") || before=""
  vbefore=$(version_of "$id")

  if (( ASSUME_YES )); then
    omarchy plugin update "$id" --yes || { warn "$id did not update"; return 0; }
  else
    omarchy plugin update "$id" || { warn "$id did not update"; return 0; }
  fi

  after=$(head_of "$id")
  vafter=$(version_of "$id")
  SEEN+=("$id|$vafter|${after:-?}")

  if [[ -n $before && -n $after && $before != "$after" ]]; then
    # A version that did not move while the code did is worth seeing rather
    # than hiding: it means the author shipped without bumping the manifest,
    # and "0.1.0" on two different checkouts is a thing you want to know.
    if [[ $vbefore != "$vafter" ]]; then
      shown="$vbefore → $vafter"
    else
      shown="$vafter (unchanged)"
    fi
    MOVED+=("$id|$shown|$before → $after")
  fi
}

step "Widgets"
update_one "$ID"

step "Companions"
for cid in "${COMPANIONS[@]}"; do
  if [[ -d "$PLUGINS_DIR/$cid" ]]; then
    printf '  %-28s %-22s %s\n' "$cid" "$(version_of "$cid")" "$(head_of "$cid")"
    say "  update it yourself when you want to, with:"
    say "      omarchy plugin update $cid"
  else
    say "  $cid is not installed — the Omate card stays inert"
  fi
done

report() {
  local line id ver where
  for line in "$@"; do
    IFS='|' read -r id ver where <<<"$line"
    printf '  %-28s %-22s %s\n' "$id" "$ver" "$where"
  done
}

if (( ${#MOVED[@]} == 0 )); then
  step "Nothing moved"
  say "  already on the newest of each; leaving the shell alone"
  (( ${#SEEN[@]} )) && report "${SEEN[@]}"
  exit 0
fi

step "Updated"
report "${MOVED[@]}"

step "Restarting the shell"
if omarchy-restart-shell; then
  say "  done — the new code is what is on your desktop"
else
  warn "the shell did not restart. The update is on disk; run 'omarchy restart shell' to see it."
  exit 1
fi
